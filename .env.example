# ------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.
# ------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Database (docker-compose starts this Postgres for you)
DATABASE_URL=postgresql://refundradar:refundradar@localhost:5432/refundradar?schema=public

# Encryption key for receipt files and email text. REQUIRED.
# Make one with:  npm run gen:key   (64 hex characters). Keep it secret and backed up:
# if you lose it, stored receipt files can't be read.
ENCRYPTION_KEY=

# AI receipt reader + claim letter writer (Google Gemini: aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Authentication
#   firebase = real Firebase login (production)
#   dev      = local testing only: log in with any email, no password.
#              Refused when NODE_ENV=production.
AUTH_MODE=dev

# Firebase Admin (server side) — Firebase console > Project settings > Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on one line, in quotes, with \n for line breaks
FIREBASE_PRIVATE_KEY=

# Firebase web app config (browser side) — Project settings > General > Your apps
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=

# Who can open /admin (comma-separated emails)
ADMIN_EMAILS=

# Countries we accept customers from. Start with one (SPEC.md). Others join the waitlist.
LAUNCH_COUNTRIES=GB

# Receipt forwarding (Postmark inbound)
INBOUND_EMAIL_DOMAIN=in.refundradar.app
# Secret added to the inbound webhook URL: /webhooks/inbound-email?token=...  (24+ random characters)
INBOUND_WEBHOOK_TOKEN=change-me-to-a-long-random-string

# Uploads and retention
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Raw receipt files and email text are deleted after this many days
RAW_RETENTION_DAYS=30

# Our fee: percent of recovered money (20–30)
FEE_PERCENT=25
# Bump this when you change the terms; users accept the new version before approving claims
TERMS_VERSION=2026-11-04

# Fee collection
#   manual = you invoice customers after a win and mark fees paid in /admin (works from Pakistan today)
#   stripe = card saved at signup, fee charged automatically after a win (needs a Stripe account)
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
# From Stripe dashboard > Developers > Webhooks, endpoint https://YOUR-SITE/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Run the background worker inside the web server (true), or separately with `npm run worker` (false)
WORKER_INLINE=true
